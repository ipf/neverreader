<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher background. A full-bleed brand-teal gradient.

    The stops reference colour resources so values-night/colors.xml can deepen
    them for a dark launcher, which a literal #RRGGBB in this file could not do.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="@color/ic_launcher_bg_start"
                android:endColor="@color/ic_launcher_bg_end" />
        </aapt:attr>
    </path>
</vector>
