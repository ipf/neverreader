<?xml version="1.0" encoding="utf-8"?>
<!--
    A perched raven, white on the brand teal.

    The art is authored around the origin and scaled down by the group below so
    that, once the launcher crops the 108dp canvas to its 72dp mask, the whole
    bird still sits inside the 66dp safe circle. Every point is within r=33 of
    (54,54); the leg was dropped because at the ~32dp the foreground is actually
    rendered at, it was sub-pixel.

    The eye is an evenOdd subpath, so it is a real hole and the background
    gradient shows through rather than being painted over.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.76"
        android:scaleY="0.76">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M85,36
                C79,32 72,31 66,33
                C62,28 54,28 49,33
                C45,38 43,43 40,50
                C35,60 31,70 29,75
                L22,83
                C31,80 41,78 50,78
                C58,78 64,74 68,68
                C72,61 74,50 75,42
                C77,37 79,35 80,35
                L85,36
                Z
                M60,34
                a3.5,3.5 0 1,0 0.001,0
                Z" />
    </group>
</vector>
