<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_graph"
    app:startDestination="@id/saves"
    >
    
    <fragment
        android:id="@+id/saves"
        android:name="com.neverreader.app.list.MyListFragment"
        android:label="MyListFragment">
        
        <action
            android:id="@+id/goToReader"
            app:destination="@id/reader"/>
        
        <action
            android:id="@+id/goToSettings"
            app:destination="@id/settings"/>
    </fragment>
    
    <fragment
        android:id="@+id/settings"
        android:name="com.neverreader.app.settings.PrefsFragment"
        android:label="PrefsFragment">
        
        <action
            android:id="@+id/goToSaves"
            app:popUpTo="@id/saves"
            app:destination="@id/saves"/>
        
        <action
            android:id="@+id/goToReader"
            app:destination="@id/reader"/>
    
        <action
            android:id="@+id/goToOpenSourceLicenses"
            app:destination="@id/openSourceLicenses"
            />
    </fragment>
    
    <fragment
        android:id="@+id/reader"
        android:name="com.neverreader.app.reader.ReaderFragment"
        android:label="ReaderFragment">
        <argument android:name="url" app:argType="string"/>
    </fragment>
    
    <fragment
        android:id="@+id/openSourceLicenses"
        android:name="com.neverreader.app.settings.OpenSourceLicensesFragment"
        android:label="OpenSourceLicensesFragment"
        />
</navigation>
