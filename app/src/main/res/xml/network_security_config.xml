<?xml version="1.0" encoding="utf-8"?>
<!--
    User-installed certificate authorities are not trusted. A self-hosted server
    therefore needs a certificate from an authority the device already trusts: a
    private CA installed system-wide, or a public one. A certificate the server
    operator generated themselves is rejected.

    That is the point. Trusting the user store means any app that can put up a
    "install a CA certificate?" prompt can intercept this app's traffic,
    including the OAuth token exchange, and a self-signed certificate the app
    never validates is the weakest link in a local-first client.

    Cleartext remains permitted, which is a separate decision and the weaker of
    the two. The host is chosen at runtime, and the only API for scoping
    cleartext to a single host - NetworkSecurityPolicy.Builder plus
    Application.setNetworkSecurityPolicy - is @hide, so it cannot be called from
    app code. Denying cleartext outright would break the plain-HTTP instances on
    a LAN this app exists to serve, so it stays and is baselined in lint.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
