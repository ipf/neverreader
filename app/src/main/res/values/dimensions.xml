<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Kept deliberately: the ui module declares the same names, but a library
        resource is resolved by name against the merged table at runtime, so
        these values are what ui actually draws with on large screens.
    -->
    <dimen name="saves_image_width">90dp</dimen>
    <dimen name="saves_image_height">60dp</dimen>
</resources>
