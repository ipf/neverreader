<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NeverReaderDefault" parent="Theme.NeverReaderDefault.Light" />

    <!--
        The base themes live here rather than in the ui module because they have
        to resolve before any composable runs: the activity picks one of these in
        setActivityTheme, and the window background comes from it, so Compose
        cannot supply them.

        values-v23 and values-v28 replace these two styles wholesale to add the
        windowLightStatusBar and windowLightNavigationBar items that did not
        exist before those API levels. The copies in this file are therefore the
        pre-23 fallback and are unreachable at minSdk 26; they are kept because
        a style named here is still the declaration the qualified versions
        override, and dropping them would leave the qualified files with no
        unstyled baseline to read against.
    -->
    <style name="Theme.NeverReaderBase.Dark" parent="Theme.AppCompat.NoActionBar">
        
        <!-- NOTE! These values should be duplicated in the Theme.NeverReaderBase.Light theme. -->
        <!-- NOTE! Using default Android colors for primary, primary dark and accent and overriding specific view themes when needed. -->
        
        <item name="android:statusBarColor">@color/nr_dm_base_bg</item>
        <item name="android:windowContentOverlay">@null</item> <!-- This removes the status bar drop shadow. It is unclear why this needs to be set here and why the setting in Theme.NeverReaderDefault.Dark doesn't work for Material. -->
    </style>
    
    <style name="Theme.NeverReaderBase.Light" parent="Theme.AppCompat.Light.NoActionBar">
        
        <!-- NOTE! These values should be duplicated in the Theme.NeverReaderBase.Dark theme. -->
        <!-- NOTE! Using default Android colors for primary, primary dark and accent and overriding specific view themes when needed. -->
        
        <item name="android:statusBarColor">@color/nr_grey_3</item>
        <item name="android:windowContentOverlay">@null</item> <!-- This removes the status bar drop shadow. It is unclear why this needs to be set here and why the setting in Theme.NeverReaderDefault.Light doesn't work for Material. -->
    </style>

    <!-- The following base styles unfortunately have to have duplicate values. -->

    <style name="Theme.NeverReaderDefault.Light" parent="Theme.NeverReaderBase.Light">
        <item name="android:cacheColorHint">@color/transparent</item>
        <item name="android:fadingEdge">none</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item> <!-- remove status bar drop shadow -->
        <item name="android:colorEdgeEffect" tools:targetApi="lollipop">@color/black</item>

        <item name="popupMenuStyle">@style/LightPopupMenu</item>
        
    </style>

    <style name="Theme.NeverReaderDefault.Dark" parent="Theme.NeverReaderBase.Dark">
        <item name="android:cacheColorHint">@color/transparent</item>
        <item name="android:fadingEdge">none</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item> <!-- remove status bar drop shadow -->
        <item name="android:colorEdgeEffect" tools:targetApi="lollipop">@color/white</item>

        <item name="popupMenuStyle">@style/DarkPopupMenu</item>

    </style>
    
    <style name="Theme.NeverReaderDefault.Light.Transparent" parent="Theme.NeverReaderDefault.Light">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    
    <style name="Theme.NeverReaderDefault.Light.Transparent.NoAnimation" parent="Theme.NeverReaderDefault.Light.Transparent">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="LightPopupMenu" parent="@style/Widget.AppCompat.Light.PopupMenu">
        <item name="overlapAnchor">true</item>
    </style>
    <style name="DarkPopupMenu" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="overlapAnchor">true</item>
    </style>

    <!-- Modified Theme.Transparent, removed android:windowIsFloating true -->
</resources>
