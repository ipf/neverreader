<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>

        <!-- Apps that can open a URL (e.g. browsers) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>


        <!-- Apps that accept sharing plaintext -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>

    </queries>

    <application
        android:name="com.neverreader.app.App"
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/nm_icon"
        android:theme="@style/Theme.NeverReaderDefault"
        android:localeConfig="@xml/locale_config"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main Activities -->
        <activity
            android:name="com.neverreader.app.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan|stateAlwaysHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.neverreader.app.auth.AuthenticationActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:launchMode="singleTask"
            android:exported="true"
            >
            <!--
                Where Readeck sends the browser back once the user has approved
                the authorization. Must match ReadeckAuth.REDIRECT_URI exactly:
                the server compares the redirect_uri it is given against the one
                registered with the client and refuses to redirect on a
                mismatch.

                Exported and unverified, which is why the flow is PKCE - an
                interceptor gets the code but not the verifier, so it cannot
                redeem it. Verified https App Links are not an option, because
                we do not control the domain a self-hosted instance runs on.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.neverreader.app" android:host="oauth-callback" />
            </intent-filter>
        </activity>

        <!-- Exported Components (Available to other apps) -->
        <activity
            android:name="com.neverreader.app.add.AddActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Transparent.StandaloneDialogActivity2"
            android:exported="true"
            android:label="@string/nm_add_to_ril"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity-alias
            android:name="com.ideashower.readitlater.activity.AddActivity"
            android:label="@string/nm_add_to_ril"
            android:exported="true"
            android:targetActivity="com.neverreader.app.add.AddActivity" >
            <intent-filter android:label="@string/nm_add_to_ril" >
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>



        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths">
            </meta-data>
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge"
            >
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove"
                />
        </provider>
    </application>

</manifest>
