# Copy to .env to override any of these. Every value is local and throwaway.
# Do not reuse any of it anywhere real.

# Host ports. Change if something already listens on these.
READECK_PORT=8000
WALLABAG_PORT=8080

# Readeck's own database, reachable only inside the compose network.
READECK_DB_NAME=readeck
READECK_DB_USER=readeck
READECK_DB_PASSWORD=readeck

# Signs Readeck's sessions and OAuth tokens. Must not change between runs, or
# every existing session and token is invalidated.
READECK_SECRET_KEY=dev-secret-not-for-production-0e3f9a

# Wallabag's database. The root password is also handed to the wallabag
# container: its entrypoint only provisions the schema when this is set.
WALLABAG_DB_NAME=wallabag
WALLABAG_DB_USER=wallabag
WALLABAG_DB_PASSWORD=wallabag
WALLABAG_DB_ROOT_PASSWORD=wallabag-root

WALLABAG_SECRET=dev-secret-not-for-production-91bc2e

# The demo account seed.sh creates, and the OAuth client it registers.
DEMO_USER=demo
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=password

# random_id part of the Wallabag OAuth client. The full client_id also contains
# the database row id, which seed.sh prints.
WALLABAG_RANDOM_ID=neverreader
WALLABAG_CLIENT_SECRET=neverreader
