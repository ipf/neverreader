local.properties

*.iml

.gradle/
/build/
/*/build/

captures

gradle.deps
/app/merged_manifests/
/utils/bin/
/.idea/
/.kotlin/

# Signing keys. A password-protected one was tracked from the original Pocket
# history and is not referenced by any buildType here, but publishing it to a
# public repository discloses the key permanently.
*.keystore
*.jks
*.p12

# Where scripts/make-signing-secrets.sh writes the release key and its password.
# The *.jks rule above already covers the key; this covers the password file
# beside it, which has no extension.
release/
