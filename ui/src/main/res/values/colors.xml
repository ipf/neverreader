<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        These color palettes follow the design team's spec:
        https://www.figma.com/file/ZJfEMS2fVY0TdB2Ao3uWv8/FINAL-Design-System?node-id=3434%3A3542

        All colors should be defined in this file and should use the official palette.
        Do not define color outside of this file.

        If a new color is introduced that doesn't match the palette, double check
        with design that they intended to introduce a new color. If it is a new color,
        ask for a name, and a dark color to go with it.

        For most components, when you reference a color, you can use the nr_themed_*  version to
        automatically get dark mode support for your component. However, at times, for
        certain components there may be exceptions to those rules. If there is an exception to the
        default color pairings, please add a comment with `theme-pairing-exception` in your state
        list file to make it obvious that it was intentional.
    -->

    <!--
        A few colors held over from the old LaCroix which don't have definitions in the current
        system. These are still used in image placeholders as the background color.
    -->

    <!-- Functional definitions -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="transparent">#00000000</color>

    <!-- Light Mode Color Palette -->
    <color name="nr_base_bg">@color/white</color>
    <color name="nr_grey_2">#333333</color>
    <color name="nr_grey_3">#404040</color>
    <color name="nr_grey_6">#D9D9D9</color>
    <color name="nr_teal_2">#008078</color>
    <color name="nr_teal_3">#009990</color>
    <color name="nr_teal_4">#80BFBB</color>
    <color name="nr_coral_2">#EF4056</color>

    <!-- Dark Mode Color Palette -->
    <color name="nr_dm_base_bg">#1A1A1A</color>
    <color name="nr_dm_grey_1">#F2F2F2</color>
    <color name="nr_dm_grey_3">#CCCCCC</color>
    <color name="nr_dm_grey_6">#404040</color>
    <color name="nr_dm_teal_3">#00CCC0</color>
    <color name="nr_dm_teal_4">#0D4643</color>
    <color name="nr_dm_coral_2">#EF4056</color>
    
    <!-- Text Color Palette -->
    
    <!-- New Color System -->
    <color name="amber_30">#FCB643</color>

    <!--
        Themed colours. These were state_dark selectors; the dark values now live in
        values-night/colors.xml, which Android resolves natively.
    -->
    <color name="nr_bg">@color/nr_base_bg</color>
    <color name="nr_themed_coral_2">@color/nr_coral_2</color>
    <color name="nr_themed_grey_6">@color/nr_grey_6</color>
    <color name="nr_themed_teal_3">@color/nr_teal_3</color>
    <color name="nr_themed_teal_4">@color/nr_teal_4</color>
    <color name="nr_themed_amber_1">@color/amber_30</color>
    <color name="nr_grey_4">#737373</color>
</resources>
