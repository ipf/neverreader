<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_height="wrap_content"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout"
    >

    <com.neverreader.ui.view.button.IconButton
        android:id="@+id/leftIcon"
        style="@style/App_IconButton"
        android:layout_height="0dp"
        android:layout_width="wrap_content"
        android:layout_marginStart="@dimen/nr_side_grid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.neverreader.ui.view.themed.ThemedView
        style="@style/App_ThinDivider"
        android:id="@+id/divider"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.neverreader.ui.view.themed.ThemedTextView
        android:id="@+id/title"
        style="@style/App_Text_AppBarTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/nr_app_bar_height"
        android:paddingStart="@dimen/nr_side_grid"
        android:paddingLeft="@dimen/nr_side_grid"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintEnd_toStartOf="@+id/actions"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftIcon"
        app:layout_constraintTop_toTopOf="parent"
        app:paddingVerticalCenter="true" />

    <com.neverreader.ui.view.themed.ThemedLinearLayout
        android:id="@+id/actions"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:paddingRight="@dimen/nr_side_grid"
        android:paddingEnd="@dimen/nr_side_grid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</merge>