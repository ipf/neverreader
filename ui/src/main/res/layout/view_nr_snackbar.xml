<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.neverreader.ui.view.notification.AppSnackbar">

    <com.neverreader.ui.view.visualmargin.VisualMarginConstraintLayout
        android:id="@+id/snackbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <com.neverreader.ui.view.button.IconButton
            android:id="@+id/icon"
            style="@style/App_IconButton"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/nr_space_sm"
            android:layout_marginBottom="@dimen/nr_space_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.neverreader.ui.view.themed.ThemedTextView
            android:id="@+id/title"
            style="@style/App_Text_Title"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:visualMargin_top="@dimen/nr_space_md"
            app:layout_goneMarginBottom="@dimen/nr_space_md"
            app:layout_goneMarginStart="@dimen/nr_space_md"
            app:layout_goneMarginLeft="@dimen/nr_space_md"
            app:layout_goneMarginRight="@dimen/nr_space_md"
            app:layout_goneMarginEnd="@dimen/nr_space_md"
            app:layout_constraintBottom_toTopOf="@+id/message"
            app:layout_constraintEnd_toStartOf="@+id/actionButton"
            app:layout_constraintStart_toEndOf="@id/icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <com.neverreader.ui.view.themed.ThemedTextView
            android:id="@id/message"
            style="@style/App_Text_Light"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:visualMargin_top="@dimen/nr_space_sm"
            app:visualMargin_goneTop="@dimen/nr_space_md"
            android:layout_marginBottom="@dimen/nr_space_md"
            android:ellipsize="end"
            app:layout_goneMarginStart="@dimen/nr_space_md"
            app:layout_goneMarginLeft="@dimen/nr_space_md"
            app:layout_goneMarginRight="@dimen/nr_space_md"
            app:layout_goneMarginEnd="@dimen/nr_space_md"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/actionButton"
            app:layout_constraintStart_toEndOf="@id/icon"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintVertical_chainStyle="packed" />

        <com.neverreader.ui.view.themed.ThemedTextView
            android:id="@+id/actionButton"
            style="@style/App_Text_Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/nr_space_sm"
            android:layout_marginTop="@dimen/nr_space_sm"
            android:layout_marginEnd="@dimen/nr_space_md"
            android:layout_marginBottom="@dimen/nr_space_sm"
            android:background="@drawable/nr_ripple_borderless"
            android:paddingBottom="4dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/message"
            app:layout_constraintTop_toTopOf="parent" />

    </com.neverreader.ui.view.visualmargin.VisualMarginConstraintLayout>
</merge>